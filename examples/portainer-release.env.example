# ZockArchive image-only release stack variables for Portainer.
# Enter values in Portainer's stack environment. Keep this tracked template
# value-free and never commit a filled environment file.

# Required Portainer secrets. Generate independent high-entropy values.
ZA_DB_PASSWORD=
ZA_DB_ROOT_PASSWORD=
ZA_AUTH_SECRET_KEY=

# Required host path. ZA_LIBRARY_PATH is mounted read-only.
ZA_LIBRARY_PATH=

# Advanced optional host-path overrides. Leave empty for the default persistent
# named volumes for assets and configuration. When set, each absolute host path
# replaces its corresponding named volume and must be writable by ZA.
ZA_ASSETS_PATH=
ZA_CONFIG_PATH=

# Normal stack variables. Leave blank to use the Compose defaults: the exact
# 0.1.0-beta.1 image tag, HTTP port 8080, UTC timezone, and default
# ZockArchive database/user names.
ZA_IMAGE_TAG=
ZA_HTTP_PORT=
ZA_TZ=
ZA_DB_NAME=
ZA_DB_USER=

# Advanced local-proof-only override. Leave blank for a normal Portainer
# deployment, which pulls ghcr.io/d1skanime/zockarchive.
ZA_IMAGE_REPOSITORY=

# Optional metadata-provider settings. Leave blank when the provider is not
# configured. ScreenScraper values identify an operator account; RetroAchievements
# and SteamGridDB values are API keys; IGDB values are Twitch client credentials.
# ScreenScraper developer-build inputs are already embedded in the release image,
# which is a documented image limitation, not runtime inputs. Set Hasheous to a
# normal stack boolean only when its metadata integration should be disabled.
ZA_SCREENSCRAPER_USER=
ZA_SCREENSCRAPER_PASSWORD=
ZA_RETROACHIEVEMENTS_API_KEY=
ZA_STEAMGRIDDB_API_KEY=
ZA_IGDB_CLIENT_ID=
ZA_IGDB_CLIENT_SECRET=
ZA_HASHEOUS_API_ENABLED=
